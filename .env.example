# Copia este archivo a .env para trabajar en local (el .env NO se sube a Git).
# En Kubernetes estos valores viven en kubernetes/01-configmap.yaml y en el Secret.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=pander_db
DB_USER=postgres
